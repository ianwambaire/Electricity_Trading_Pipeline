# Public/non-secret API configuration ONLY. Never copy ingestion .env/secrets here.
# Proposal: replace example hosts with separately approved staging names.
POWERFLOW_API_ENV=staging
POWERFLOW_API_ALLOWED_HOSTS=staging.powerflowenergy.dev,localhost,127.0.0.1
# Same-origin /api proxy needs no CORS; optional comma-separated exact HTTPS origins.
POWERFLOW_API_CORS_ORIGINS=
POWERFLOW_API_DATA_ROOT=/srv/powerflow/published
POWERFLOW_API_COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_NLoYFRvex
# Replace with an approved SPA client; never a client secret.
POWERFLOW_API_COGNITO_CLIENT_IDS=4t8s6a673a18qhbauqac8rhdcf
POWERFLOW_API_REQUIRED_SCOPES=
# Set only for explicitly resource-bound tokens; otherwise leave unset.
# POWERFLOW_API_COGNITO_AUDIENCE=https://approved-api-resource
POWERFLOW_ACCOUNT_TOTP_ENABLED=false
POWERFLOW_ACCOUNT_TOTP_TEST_SUBJECT=
