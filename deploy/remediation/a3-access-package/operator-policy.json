{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::870755688674:role/PowerFlowA3Uploader",
        "arn:aws:iam::870755688674:role/PowerFlowA3Reader"
      ],
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    },
    {
      "Sid": "LocalBrowserSignInOnly",
      "Effect": "Allow",
      "Action": [
        "signin:AuthorizeOAuth2Access",
        "signin:CreateOAuth2Token"
      ],
      "Resource": "arn:aws:signin:us-east-1:870755688674:oauth2/public-client/localhost"
    }
  ]
}
