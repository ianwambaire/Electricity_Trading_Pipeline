# Safe template only. Copy to .streamlit/secrets.toml and replace both secret
# placeholders locally. The real file is ignored by Git.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_VALUE"

[auth.cognito]
client_id = "5qa93km3lf2bbu3ffnrpea4r3g"
client_secret = "REPLACE_WITH_THE_COGNITO_APP_CLIENT_SECRET"
server_metadata_url = "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_NLoYFRvex/.well-known/openid-configuration"
client_kwargs = { scope = "openid email profile" }
