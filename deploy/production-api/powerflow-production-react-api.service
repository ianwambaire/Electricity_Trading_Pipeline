[Unit]
Description=PowerFlow React production API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=powerflow-api
Group=powerflow-api
WorkingDirectory=/opt/powerflow/production-react-api/current
EnvironmentFile=/etc/powerflow/production-react-api.env
Environment=PYTHONPATH=/opt/powerflow/production-react-api/current/src
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=AWS_EC2_METADATA_DISABLED=true
# Verify cgroup-BPF support in isolated Linux staging; never ignore failures.
IPAddressDeny=169.254.169.254/32
IPAddressDeny=fd00:ec2::254/128
ExecStart=/opt/powerflow/production-react-api/current/.venv-api/bin/uvicorn api.app:app --host 127.0.0.1 --port 8011 --workers 1 --no-access-log --proxy-headers --forwarded-allow-ips=127.0.0.1 --limit-concurrency 32 --timeout-keep-alive 5 --timeout-graceful-shutdown 20
Restart=on-failure
RestartSec=5
# Proposed caps require isolated peak testing before shared-host use.
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/powerflow/production-published
InaccessiblePaths=-/srv/powerflow/published -/srv/powerflow/forecast-publications -/srv/powerflow/operational-publications -/srv/powerflow/realized-performance -/srv/powerflow/price-only-forecast
CapabilityBoundingSet=
TasksMax=64
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0
CPUQuota=100%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
