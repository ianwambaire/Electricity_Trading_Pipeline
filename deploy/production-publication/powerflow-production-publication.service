[Unit]
Description=Project production PowerFlow evidence into its isolated API publication store
ConditionPathIsDirectory=/srv/powerflow/production-published

[Service]
Type=oneshot
User=root
Group=powerflow-api
UMask=0027
WorkingDirectory=/opt/powerflow/production-publication/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/powerflow/production-publication/current/src
ExecStart=/opt/powerflow/production-publication/current/venv/bin/python -s /opt/powerflow/production-publication/current/writer.py
TimeoutStartSec=150
MemoryMax=384M
CPUQuota=50%
Nice=10
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/ec2-user/Electricity_Trading_Pipeline
ReadWritePaths=/srv/powerflow/production-published
InaccessiblePaths=-/srv/powerflow/published -/srv/powerflow/forecast-publications -/srv/powerflow/operational-publications -/srv/powerflow/realized-performance -/srv/powerflow/price-only-forecast
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
TasksMax=32
