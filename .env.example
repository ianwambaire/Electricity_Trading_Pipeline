# Secrets backend: env (default), ssm, or secretsmanager.
POWERFLOW_SECRETS_BACKEND=env
# Default AWS identifier prefix. Individual identifiers can be overridden with
# POWERFLOW_SECRET_ID_<SECRET_NAME> without placing values in this file.
POWERFLOW_SECRETS_PREFIX=/powerflow/production
# Dashboard authentication is disabled for local development by default.
# Production should set true and store POWERFLOW_AUTH_USERS_JSON in the selected
# secrets backend. The JSON must contain password hashes, never passwords.
POWERFLOW_AUTH_ENABLED=false
POWERFLOW_AUTH_USERS_JSON=
POWERFLOW_SESSION_TIMEOUT_MINUTES=60
POWERFLOW_MAX_LOGIN_ATTEMPTS=5
POWERFLOW_LOGIN_LOCKOUT_MINUTES=10
EIA_API_KEY=
ENTSOE_API_KEY=
POWERFLOW_HISTORY_START_DATE=2019-01-01
POWERFLOW_HISTORY_END_DATE=2025-09-30
POWERFLOW_STORAGE_BACKEND=local
POWERFLOW_S3_BUCKET=powerflow-data-ian-2026-870755688674-us-east-1-an
AWS_REGION=us-east-1
# Prefect server metadata only. URL-encode special characters in the password.
# PREFECT_SERVER_DATABASE_CONNECTION_URL=postgresql+asyncpg://prefect:URL_ENCODED_PASSWORD@127.0.0.1:5432/prefect
# Optional local-backend root; defaults to the repository working directory.
# POWERFLOW_LOCAL_STORAGE_ROOT=.
ALERT_EMAIL_SENDER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_RECEIVER=
# Suppress repeat emails for the same unresolved failure fingerprint (1-168 hours).
POWERFLOW_ALERT_COOLDOWN_HOURS=12
